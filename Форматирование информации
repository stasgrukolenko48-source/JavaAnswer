/**
 * Демонстрация базовых спецификаторов форматирования.
 * Практика #1.
 */
public class BasicFormattingDemo {

    public static void main(String[] args) {
        String swimmerName = "Иванов Иван";
        int distance = 100;
        double timeSeconds = 52.458;
        boolean isPersonalBest = true;

        // Выбираем 5 спецификаторов: 
        // %s - строка
        // %d - целое число
        // %f - число с плавающей точкой (добавим .2, чтобы округлить до сотых)
        // %b - boolean
        // %n - платформонезависимый перенос строки (лучше, чем \n)

        System.out.printf(
            "Пловец: %s%nДистанция: %d м%nВремя: %.2f сек%nЛичный рекорд: %b%n",
            swimmerName, distance, timeSeconds, isPersonalBest
        );
        
        // Альтернативно можно собрать строку в переменную, а не выводить сразу:
        // String result = String.format("Пловец: %s...", swimmerName);
    }
}

ПРАКТИКА 2

Понятие "flush" (сброс) тесно связано с потоками ввода-вывода.

Когда мы пишем данные (особенно в файл, базу данных или отправляешь по сети), они не отправляются по одному байту мгновенно. Для повышения производительности Java сначала копит эти данные в специальном временном хранилище в оперативной памяти — буфере.

Метод flush() принудительно "проталкивает" все накопленные в буфере данные в конечное место назначения, даже если буфер еще не заполнился до конца.

import java.util.Date;

/**
 * Демонстрация спецификаторов даты и времени.
 * Практика #3.
 */
public class TimeFormattingDemo {

    public static void main(String[] args) {
        
        // Создаем объект текущей даты и времени
        Date now = new Date();

        // Выбираем 5 спецификаторов из таблицы:
        // %tA - полное название дня недели
        // %tB - полное название месяца
        // %tY - год в 4-значном формате
        // %tH - час (00-23)
        // %tM - минуты (00-59)

        System.out.printf(
            "Начало соревнований запланировано на %1$tA.%n" +
            "Месяц: %1$tB, Год: %1$tY.%n" +
            "Точное время старта: %1$tH:%1$tM.%n", 
            now
        );
        
        // ВАЖНО: конструкция '1$' говорит компилятору: 
        // "Для каждого спецификатора бери самый первый аргумент после строки форматирования (т.е. переменную now)".
    }
}
