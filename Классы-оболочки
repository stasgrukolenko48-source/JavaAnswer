/**
 * Демонстрация работы метода decode() для класса Integer.
 * Практика #1.
 *
 * @author Влад
 * @version 1.0
 */
public class DecodeDemo {
    public static void main(String[] args) {
        // Декодируем стандартное десятичное число
        Integer decimalValue = Integer.decode("125");
        System.out.println("Десятичное (125): " + decimalValue);

        // Декодируем шестнадцатеричное число (префикс 0x)
        Integer hexValue = Integer.decode("0xFF");
        System.out.println("Шестнадцатеричное (0xFF): " + hexValue); // Выведет 255

        // Декодируем восьмеричное число (префикс 0)
        Integer octalValue = Integer.decode("010");
        System.out.println("Восьмеричное (010): " + octalValue); // Выведет 8
    }
}
