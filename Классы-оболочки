/**
 * Демонстрация возникновения NullPointerException при автораспаковке.
 * Практика #3.
 *
 * @author Влад
 * @version 1.0
 */
public class UnboxingNPEDemo {
    public static void main(String[] args) {
        // Создаем объект-обертку, но не инициализируем его значением,
        // поэтому переменная хранит null.
        Integer wrapperObject = null;

        try {
            // АВТОРАСПАКОВКА: попытка присвоить null-объект в примитив.
            // Под капотом Java делает: int primitiveInt = wrapperObject.intValue();
            // Так как wrapperObject == null, вызов .intValue() бросит исключение.
            int primitiveInt = wrapperObject; 
        } catch (NullPointerException e) {
            System.out.println("Поймали NullPointerException при автораспаковке!");
        }
    }
}
