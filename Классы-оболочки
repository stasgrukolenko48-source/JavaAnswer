/**
 * Демонстрация способов создания объектов типа Boolean.
 * Практика #2.
 *
 * @author Влад
 * @version 1.0
 */
public class BooleanCreation {
    public static void main(String[] args) {
        // Способ 1: Автоупаковка (Autoboxing) базового типа boolean
        Boolean bool1 = true;

        // Способ 2: Использование статического метода valueOf() с примитивом
        Boolean bool2 = Boolean.valueOf(false);

        // Способ 3: Использование valueOf() со строкой
        // Вернет true только если строка равна "true" (без учета регистра)
        Boolean bool3 = Boolean.valueOf("TrUe");
        
        // Способ 4: Использование статических констант класса Boolean
        Boolean bool4 = Boolean.TRUE;
        Boolean bool5 = Boolean.FALSE;
        
        // Метод parseBoolean возвращает примитив (boolean), 
        // но благодаря автоупаковке мы можем присвоить его объекту Boolean
        Boolean bool6 = Boolean.parseBoolean("true");
    }
}
