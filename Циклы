ПРАКТИКА 2
/**
 * Демонстрация работы операторов управления циклом: break и continue.
 * Практика #2.
 *
 * @author Влад
 * @version 1.0
 */
public class LoopControlDemo {

    /**
     * Точка входа в программу.
     *
     * @param args параметры командной строки
     */
    public static void main(String[] args) {
        
        System.out.println("Начало цикла:");

        for (int i = 1; i <= 10; i++) {
            
            // Если число четное, мы ПРОПУСКАЕМ эту итерацию
            // и переходим к следующему шагу (i++)
            if (i % 2 == 0) {
                continue; 
            }
            
            // Если мы дошли до числа 7, мы полностью ПРЕРЫВАЕМ цикл
            if (i == 7) {
                System.out.println("Найдено число 7. Досрочный выход из цикла!");
                break; 
            }
            
            // Этот код выполнится только для нечетных чисел до 7 (т.е. для 1, 3, 5)
            System.out.println("Текущее значение i: " + i);
        }

        System.out.println("Конец программы.");
    }
}
