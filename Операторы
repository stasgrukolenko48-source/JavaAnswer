/**
 * Класс для демонстрации работы оператора instanceof.
 * Практика #2.
 * * @author Влад
 * @version 1.0
 */
public class InstanceofDemo {

    /**
     * Точка входа в программу.
     * * @param args параметры командной строки
     */
    public static void main(String[] args) {
        
        // Создаем объект типа String
        String text = "Тестовая строка";
        
        // 1. Проверка точного совпадения типа
        boolean isString = text instanceof String;
        System.out.println("text является String? " + isString); // true
        
        // 2. Проверка на принадлежность к базовому классу
        // В Java абсолютно все классы неявно наследуются от класса Object
        boolean isObject = text instanceof Object;
        System.out.println("text является Object? " + isObject); // true

        // 3. Применение instanceof к null-объекту
        String emptyString = null;
        boolean isNullString = emptyString instanceof String;
        boolean isNullObject = emptyString instanceof Object;
        
        // Любая проверка null через instanceof всегда дает false!
        // Это защищает программу от ошибки NullPointerException
        System.out.println("null является String? " + isNullString); // false
        System.out.println("null является Object? " + isNullObject); // false
    }
}
