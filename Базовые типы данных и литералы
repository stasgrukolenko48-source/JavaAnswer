public class Practice1 {
    // Объявляем переменные как поля класса, чтобы показать их дефолтные значения
    static byte b;
    static short s;
    static int i;
    static long l;
    static float f;
    static double d;
    static char c;
    static boolean bool;

    public static void main(String[] args) {
        System.out.println("byte: " + b);           // 0
        System.out.println("short: " + s);          // 0
        System.out.println("int: " + i);            // 0
        System.out.println("long: " + l);           // 0
        System.out.println("float: " + f);          // 0.0
        System.out.println("double: " + d);         // 0.0
        System.out.println("char: [" + c + "]");    // '\u0000' (пустой символ)
        System.out.println("boolean: " + bool);     // false
    }
}

