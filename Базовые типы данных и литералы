    public static void main(String[] args) {
        // String + базовый тип (int)
        int score = 100;
        String result1 = "Результат: " + score; 
        System.out.println(result1); // Выведет: Результат: 100

        // String + объект (например, массив или любой другой класс)
        Object obj = new Object();
        String result2 = "Мой объект: " + obj;
        // У объекта неявно вызовется метод .toString()
        System.out.println(result2); 
    }
}
