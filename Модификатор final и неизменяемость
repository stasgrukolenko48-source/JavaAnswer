/**
 * Демонстрация всех способов инициализации non-static final переменной.
 * Практика #1 по модификатору final.
 *
 * @author Влад
 * @version 1.0
 */
public class FinalInitializationDemo {

    // ====================================================================
    // ВАРИАНТ 1: Прямая инициализация (сразу при объявлении)
    // ====================================================================
    // Самый простой и частый способ, если значение известно заранее
    // и одинаково для всех объектов этого класса.
    public static class A1 {
        public final int a = 10; 
    }

    // ====================================================================
    // ВАРИАНТ 2: В логическом блоке инициализации экземпляра
    // ====================================================================
    // Этот блок (просто фигурные скобки внутри класса) автоматически 
    // выполняется при создании каждого нового объекта ДО вызова конструктора.
    // Часто используется, если для инициализации нужна сложная логика, 
    // циклы или обработка исключений (try-catch).
    public static class A2 {
        public final int a;

        {
            // Какие-то предварительные вычисления...
            a = 20; 
        }
    }

    // ====================================================================
    // ВАРИАНТ 3: В конструкторе
    // ====================================================================
    // Идеальный вариант, если значение константы должно задаваться извне 
    // при создании объекта (у каждого объекта оно будет final, но своим собственным).
    public static class A3 {
        public final int a;

        // Конструктор по умолчанию
        public A3() {
            a = 30;
        }
        
        // Конструктор с параметрами
        public A3(int customValue) {
            a = customValue;
        }
    }
}
