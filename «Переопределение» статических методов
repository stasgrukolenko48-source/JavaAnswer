/**
 * Демонстрация сокрытия статических методов (Method Hiding) 
 * и невозможности применения к ним динамического полиморфизма.
 * Практика #1.
 *
 * @author Влад
 * @version 1.0
 */
public class StaticPolymorphismDemo {

    static class A {
        public static void method() {
            System.out.println("Статический метод класса A");
        }
    }

    static class B extends A {
        // Аннотацию @Override здесь писать ЗАПРЕЩЕНО. 
        // Мы не переопределяем метод, мы его "скрываем".
        public static void method() {
            System.out.println("Статический метод класса B");
        }
    }

    public static void main(String[] args) {
        // Создаем объект класса B, но сохраняем его в ссылку типа A
        A obj = new B();

        // Если бы работал динамический полиморфизм, вызвался бы метод класса B
        // (так как в памяти лежит объект B).
        // Но для статических методов Java смотрит ТОЛЬКО на тип ссылки (А).
        
        obj.method(); // Выведет: "Статический метод класса A"
        
        // Примечание: вызывать статические методы через объекты (obj.method()) - 
        // плохая практика. Правильно писать A.method() или B.method().
        // Этот пример приведен исключительно для демонстрации того, как мыслит компилятор.
    }
}
