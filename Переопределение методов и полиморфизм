/**
 * Демонстрация перегрузки (overloading) и переопределения (overriding) методов.
 * Охватывает практики #1, #2 и #3.
 *
 * @author Влад
 * @version 1.0
 */
public class PolymorphismDemo {

    // ====================================================================
    // ПРАКТИКА #1: Пример перегруженных методов
    // ====================================================================
    static class DataProcessor {
        
        // Базовый метод
        public void process(int data) {
            System.out.println("Обработка целого числа: " + data);
        }

        // Перегрузка: изменен тип параметра
        public void process(String data) {
            System.out.println("Обработка строки: " + data);
        }

        // Перегрузка: изменено количество параметров и тип возвращаемого значения
        // (Доказывает, что возвращаемый тип может отличаться)
        public boolean process(int data, int multiplier) {
            System.out.println("Обработка с умножением: " + (data * multiplier));
            return true;
        }
    }

    // ====================================================================
    // ПРАКТИКА #2 и #3: Переопределение и аннотация @Override
    // ====================================================================
    static class Animal {
        
        public Animal reproduce() {
            System.out.println("Появилось новое животное.");
            return new Animal();
        }

        public void eat() {
            System.out.println("Животное ест.");
        }
    }

    static class Dog extends Animal {

        // ОТВЕТ НА ПРАКТИКУ #2: Разные типы возвращаемого значения при переопределении.
        // Если типы совершенно разные (например, родитель возвращает int, а наследник String), 
        // будет ошибка компиляции.
        // НО! В Java есть понятие "ковариантные типы". Если метод родителя возвращает класс Animal, 
        // переопределенный метод может возвращать его наследника (класс Dog). Это абсолютно законно.
        @Override
        public Dog reproduce() {
            System.out.println("Родился щенок.");
            return new Dog();
        }

        // ОТВЕТ НА ПРАКТИКУ #3: Зачем нужна аннотация @Override?
        // Допустим, мы хотели переопределить метод eat(), но случайно добавили параметр.
        // Раскомментируй код ниже, чтобы увидеть ошибку компиляции:
        
        /*
        @Override
        public void eat(String food) {
            System.out.println("Собака ест " + food);
        }
        */
        
        // ОБЪЯСНЕНИЕ: Без @Override компилятор решил бы, что мы просто создали новый 
        // перегруженный метод eat(String). Программа бы скомпилировалась, но логика сломалась бы: 
        // при вызове eat() без параметров все еще срабатывал бы метод родителя.
        // Аннотация @Override заставляет компилятор жестко проверить: "А есть ли в точности 
        // такой же метод у предка?". Если нет — он выдаст ошибку, спасая нас от бага.
    }
}
