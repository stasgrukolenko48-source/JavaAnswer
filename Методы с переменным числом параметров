/**
 * Класс для учета тренировочных результатов.
 * Демонстрирует перегрузку методов с переменным числом параметров (varargs).
 * Практика #1.
 *
 * @author Влад
 * @version 1.0
 */
public class SwimmingTraining {

    // ====================================================================
    // ПРИМЕР 1: Базовый метод с varargs
    // ====================================================================
    /**
     * Рассчитывает среднее время прохождения дистанции для группы.
     *
     * @param times результаты заплывов в секундах (может быть передано 0 и более аргументов)
     */
    public void analyzeResults(double... times) {
        if (times.length == 0) {
            System.out.println("Нет результатов для анализа.");
            return;
        }
        double sum = 0;
        for (double t : times) {
            sum += t;
        }
        System.out.println("Среднее время группы: " + (sum / times.length) + " сек.");
    }

    // ====================================================================
    // ПРИМЕР 2: Перегрузка с добавлением обычного параметра ПЕРЕД varargs
    // ====================================================================
    /**
     * Сохраняет результаты заплывов конкретного спортсмена.
     * ВАЖНО: параметр varargs ВСЕГДА должен быть самым последним в списке аргументов!
     *
     * @param swimmerName имя пловца
     * @param times результаты заплывов
     */
    public void analyzeResults(String swimmerName, double... times) {
        System.out.print("Результаты пловца " + swimmerName + ": ");
        for (double t : times) {
            System.out.print(t + " ");
        }
        System.out.println();
    }

    // ====================================================================
    // ПРИМЕР 3: Перегрузка с varargs другого типа
    // ====================================================================
    /**
     * Выводит список заданий или стилей плавания на тренировку.
     *
     * @param tasks список заданий
     */
    public void analyzeResults(String... tasks) {
        System.out.print("План на воду: ");
        for (String task : tasks) {
            System.out.print(task + ", ");
        }
        System.out.println();
    }

    /**
     * Точка входа для тестирования методов.
     */
    public static void main(String[] args) {
        SwimmingTraining training = new SwimmingTraining();

        // 1. Вызов первого метода (передаем только числа)
        training.analyzeResults(25.5, 26.1, 24.9);

        // 2. Вызов второго метода (передаем строку, а затем любое количество чисел)
        training.analyzeResults("Иванов", 24.5, 24.8);

        // 3. Вызов третьего метода (передаем только строки)
        training.analyzeResults("Кроль 400м", "Отработка поворотов");
        
        // 4. Вызов первого метода ВООБЩЕ без параметров
        // (Внутри метода times.length будет равен 0)
        training.analyzeResults(); 
    }
}
