/**
 * Демонстрация работы механизма всплытия и перехвата исключений.
 * Практика #1.
 */
public class ExceptionPropagationDemo {

    public static void main(String[] args) {
        System.out.println("Шаг 1: Программа успешно запущена.");

        // ====================================================================
        // СЦЕНАРИЙ 1: Генерируем исключение и ПЕРЕХВАТЫВАЕМ его
        // ====================================================================
        try {
            System.out.println("Шаг 2: Вызываем метод с делением на ноль...");
            generateCaughtException();
            
            // Эта строка никогда не выполнится, так как метод выше бросит исключение
            System.out.println("Этот текст вы не увидите."); 
            
        } catch (ArithmeticException e) {
            System.out.println("Шаг 3: ОШИБКА ПЕРЕХВАЧЕНА! Причина: " + e.getMessage());
            System.out.println("Программа восстановилась и готова работать дальше.");
        }

        // ====================================================================
        // СЦЕНАРИЙ 2: Генерируем исключение и НЕ перехватываем его
        // ====================================================================
        System.out.println("\nШаг 4: Вызываем метод с NullPointerException...");
        
        // Здесь нет блока try-catch. Ошибка всплывет в main, и программа упадет.
        generateCrashException();

        // ====================================================================
        // Мертвый код. Из-за аварийной остановки выше, программа сюда не дойдет.
        // ====================================================================
        System.out.println("Шаг 5: Программа успешно завершена.");
    }

    /**
     * Метод генерирует ArithmeticException.
     */
    public static void generateCaughtException() {
        int result = 10 / 0; 
    }

    /**
     * Метод генерирует NullPointerException.
     */
    public static void generateCrashException() {
        String text = null;
        int length = text.length(); 
    }
}
