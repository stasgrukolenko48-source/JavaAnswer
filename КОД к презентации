package main;
public class Program {
    public static void mainn(String[] args) {
        // Java сама найдет класс SwimWork в этой же папке
        SwimWork myTrain = new SwimWork("Брасс", 1000); 
        
        myTrain.startWarmup();
        System.out.println("Эта тренировка сложная? " + myTrain.isHard);
    }
    public static void main(String[] args) {
        SwimWork train = new SwimWork("Кроль", 1500);

        // 1. PUBLIC — Сработает без проблем
        System.out.println("Тренер: " + train.coachName);

        // 2. DEFAULT — Сработает, так как файлы в одной папке
        System.out.println("Людей в бассейне: " + train.swimmersCount);

        // 3. PROTECTED — Сработает (мы в одном пакете)
        System.out.println("Лицензия бассейна: " + train.poolLicense);

        // 4. PRIVATE — ВНИМАНИЕ! Эта строчка вызовет КРАСНУЮ ОШИБКУ
        // System.out.println(train.coachSalary); 
        
        // А так — сработает (через геттер)
        System.out.println("Зарплата через геттер: " + train.getSalary());
    }
}
