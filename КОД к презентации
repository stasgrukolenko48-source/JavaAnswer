// общая концепция сотрудника
abstract class Employee {
    private String name;
    private int id;

    public Employee(String name, int id) {
        this.name = name;
        this.id = id;
    }

    public void displayInfo() {
        System.out.println("ID: " + id + ", Имя: " + name);
    }


    public abstract double calculateSalary();
}


class FullTimeEmployee extends Employee {
    private double monthlySalary;

    public FullTimeEmployee(String name, int id, double monthlySalary) {
        super(name, id); // Вызов конструктора абстрактного класса
        this.monthlySalary = monthlySalary;
    }

    @Override
    public double calculateSalary() {
        return monthlySalary;
    }
}

class ContractEmployee extends Employee {
    private double hourlyRate;
    private int hoursWorked;

    public ContractEmployee(String name, int id, double hourlyRate, int hoursWorked) {
        super(name, id);
        this.hourlyRate = hourlyRate;
        this.hoursWorked = hoursWorked;
    }

    @Override
    public double calculateSalary() {
        return hourlyRate * hoursWorked;
    }
}


public class Company {
    public static void main(String[] args) {

        Employee emp1 = new FullTimeEmployee("Алексей", 101, 80000);
        Employee emp2 = new ContractEmployee("Мария", 102, 500, 160);

        Employee[] staff = {emp1, emp2};

        for (Employee e : staff) {
            e.displayInfo();
            System.out.println("Зарплата: " + e.calculateSalary());
            System.out.println("---");
        }



      Employee specialTaskWorker = new Employee("Инкогнито", 999) {
            private double bonus = 5000.0;

            @Override
            public double calculateSalary() {
                return 25000.0 + bonus;
            }
            
            @Override
            public void displayInfo() {
                super.displayInfo();
                System.out.println("Статус: Секретный сотрудник");
            }
        };

        specialTaskWorker.displayInfo();
        System.out.println("Зарплата: " + specialTaskWorker.calculateSalary());
    }

}


