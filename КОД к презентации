// Первый интерфейс с приватным методом
interface Messaging {
    // Default-метод, доступный классу-реализатору
    default void sendMessage(String message) {
        logAction("Sending"); // Вызов приватного метода
        System.out.println("Сообщение: " + message);
    }

    // Приватный метод интерфейса (Java 9+)
    // Нужен для внутренней логики интерфейса, не виден снаружи
    private void logAction(String action) {
        System.out.println("[LOG] Действие: " + action);
    }
}

// Второй интерфейс
interface Encryption {
    default void encryptData() {
        System.out.println("Шифрование данных...");
    }
}

// Класс, реализующий множественное наследование интерфейсов
class SecureMessenger implements Messaging, Encryption {
    public void run() {
        encryptData();     // Метод из Encryption
        sendMessage("Привет!"); // Метод из Messaging
    }
}

// Тестирование
public class Main {
    public static void main(String[] args) {
        SecureMessenger messenger = new SecureMessenger();
        messenger.run();
    }
}

