package main;
public class SwimWork {
    public String coachName = "Влад";      // PUBLIC: Видят все (и клиенты, и другие залы)
    private double coachSalary = 50000.0;  // PRIVATE: Видит только этот класс (инкапсуляция)
    protected String poolLicense = "A105"; // PROTECTED: Видят только "свои" и наследники
    int swimmersCount = 15;                // DEFAULT (пакетный): Видят все в этой папке
    
    String style;
    int distance;
    boolean isHard;

    public SwimWork(String style, int distance) {
        this.style = style;
        this.distance = distance;
        this.isHard = distance > 2000;
    }

    void startWarmup() {
        System.out.println("Начинаем разминку для стиля " + style);
    }
    public double getSalary() {
        return coachSalary;
    }
}
