import java.io.FileNotFoundException;
import java.io.IOException;

/**
 * Демонстрация обработки нескольких исключений.
 * Практика #1.
 *
 * @author Влад
 */
public class MultiCatchDemo {

    public static void main(String[] args) {
        
        // ====================================================================
        // СИТУАЦИЯ 1: Иерархия исключений (Ex3 -> Ex2 -> Ex1)
        // Иерархия: FileNotFoundException наследуется от IOException, 
        // а IOException наследуется от Exception.
        // ====================================================================
        try {
            readTrainingPlan("plan.txt");
            
        } catch (FileNotFoundException e) {
            // 1. Самый специфичный класс (Потомок)
            System.out.println("Ошибка: Файл с планом не найден на диске.");
            
        } catch (IOException e) {
            // 2. Класс-родитель (Предок)
            System.out.println("Ошибка: Файл найден, но его не удалось прочитать.");
            
        } catch (Exception e) {
            // 3. Самый общий класс (Прадед всей иерархии исключений)
            System.out.println("Произошла какая-то непредвиденная ошибка.");
        }


        // ====================================================================
        // СИТУАЦИЯ 2: Абсолютно идентичная обработка (Multi-catch)
        // ====================================================================
        try {
            processAthleteData(null);
            
        } catch (NullPointerException | IllegalArgumentException e) {
            // Начиная с Java 7, можно объединять исключения через оператор | (ИЛИ).
            // ВАЖНО: Эти исключения НЕ должны находиться в одной цепочке наследования!
            // Например, нельзя написать catch (FileNotFoundException | IOException e).
            System.out.println("Сбой при обработке данных спортсмена: " + e.getMessage());
        }
    }

    // Методы-заглушки для демонстрации
    public static void readTrainingPlan(String path) throws IOException {
        // Имитация логики
    }

    public static void processAthleteData(String data) {
        if (data == null) throw new NullPointerException("Данные пусты");
    }
}
ПРАКТИКА 2
Ключевое слово final здесь означает то же самое, что и везде в Java: оно делает переменную e константой внутри этого блока.

Это значит, что внутри блока catch ты не сможешь переназначить ссылку e на другой объект исключения.
Например, строка e = new Exception("Новая ошибка"); вызовет ошибку компиляции.
Переназначать пойманное исключение — это очень плохая практика. Если программист случайно это сделает, он затрет оригинальную ошибку вместе с ее стеком вызовов (stack trace), и отладить программу станет практически невозможно. final защищает от такой случайной опечатки.
