/**
 * Класс для выполнения сложных математических расчетов.
 * Демонстрирует правильное использование javadoc-комментариев.
 * * @author Влад
 * @version 1.0
 * @since 2024
 */
public class MathSolver {

    // Это однострочный комментарий: константа для расчетов
    private static final double EPSILON = 0.0001; 

    /*
     * Это блочный комментарий.
     * Он удобен, если нужно оставить длинное пояснение
     * к логике внутри самого метода, которое не должно
     * попадать в официальную документацию Javadoc.
     */

    /**
     * Вычисляет результат деления двух чисел.
     * * @param a делимое
     * @param b делитель
     * @return результат деления a на b
     * @throws ArithmeticException если делитель равен нулю
     * @see Math
     */
    public static double divide(double a, double b) throws ArithmeticException {
        if (b == 0) {
            throw new ArithmeticException("Деление на ноль запрещено"); // Выброс исключения
        }
        return a / b;
    }

    /**
     * Старый метод сложения (пример устаревшего метода).
     * * @deprecated Используйте новые математические библиотеки.
     */
    @Deprecated
    public void oldAdditionMethod() {
        // Логика старого метода
    }
}
