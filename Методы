/**
 * Демонстрация перегрузки (overloading) и переопределения (overriding) методов.
 * Практика #1.
 *
 * @author Влад
 * @version 1.0
 */
public class MethodDemo {

    // ==========================================
    // 1. ПРИМЕР ПЕРЕГРУЗКИ (OVERLOADING)
    // ==========================================

    /**
     * Класс тренера, демонстрирующий перегрузку методов составления плана.
     */
    static class Coach {
        
        /**
         * Составляет базовый план тренировки по времени.
         * * @param durationMinutes длительность в минутах
         */
        public void createPlan(int durationMinutes) {
            System.out.println("План: плавать вольным стилем " + durationMinutes + " минут.");
        }

        /**
         * ПЕРЕГРУЗКА: То же имя метода, но добавлены новые параметры (стиль плавания).
         * * @param durationMinutes длительность в минутах
         * @param strokeType стиль плавания
         */
        public void createPlan(int durationMinutes, String strokeType) {
            System.out.println("План: плавать стилем '" + strokeType + "' " + durationMinutes + " минут.");
        }

        /**
         * ПЕРЕГРУЗКА: То же имя, но другой тип параметра.
         * * @param isCompetitionWeek флаг соревновательной недели
         */
        public void createPlan(boolean isCompetitionWeek) {
            if (isCompetitionWeek) {
                System.out.println("План: легкая тренировка, отработка стартов и поворотов.");
            } else {
                System.out.println("План: тяжелая силовая тренировка на воде.");
            }
        }
        
        /* * ВАЖНО ДЛЯ ЗАЧЕТА: Если мы напишем метод с такими же параметрами, но другим возвращаемым типом:
         * public String createPlan(int duration) { return "План"; }
         * Компилятор выдаст ошибку! Тип возвращаемого значения на перегрузку НЕ влияет.
         */
    }

    // ==========================================
    // 2. ПРИМЕР ПЕРЕОПРЕДЕЛЕНИЯ (OVERRIDING)
    // ==========================================

    /**
     * Базовый класс пловца-любителя.
     */
    static class Swimmer {
        /**
         * Стандартная разминка.
         */
        public void warmUp() {
            System.out.println("Любитель: махи руками 2 минуты, затем в воду.");
        }
    }

    /**
     * Класс профессионального пловца, наследующий базовый класс.
     */
    static class ProSwimmer extends Swimmer {
        
        /**
         * ПЕРЕОПРЕДЕЛЕНИЕ: Мы меняем логику родительского метода.
         * Аннотация @Override не обязательна, но крайне рекомендуется: 
         * она говорит компилятору проверить, действительно ли такой метод есть у родителя.
         */
        @Override
        public void warmUp() {
            System.out.println("Профессионал: суставная гимнастика, работа с резиной (15 минут), растяжка.");
        }
    }

    // ==========================================
    // ЗАПУСК ПРОГРАММЫ
    // ==========================================

    /**
     * Точка входа в программу.
     * * @param args аргументы командной строки
     */
    public static void main(String[] args) {
        System.out.println("--- Демонстрация перегрузки ---");
        Coach coach = new Coach();
        coach.createPlan(45);                  // Вызовет первый метод
        coach.createPlan(60, "Баттерфляй");    // Вызовет второй метод
        coach.createPlan(true);                // Вызовет третий метод

        System.out.println("\n--- Демонстрация переопределения ---");
        Swimmer amateur = new Swimmer();
        amateur.warmUp();                      // Вызовет метод базового класса

        ProSwimmer pro = new ProSwimmer();
        pro.warmUp();                          // Вызовет переопределенный метод класса-наследника
        
        // Демонстрация полиморфизма (бонус для отличного ответа на зачете):
        Swimmer unknownSwimmer = new ProSwimmer();
        unknownSwimmer.warmUp();               // Вызовет метод ProSwimmer, так как объект в памяти - профи!
    }
}
