// Представим, что мы работаем в другом классе, например, в Main
import static пакет.A.printVars; // Подготовка для Варианта 5 (статический импорт)

/**
 * Класс для демонстрации всех способов вызова статического метода.
 * Практика #1 по теме static.
 *
 * @author Влад
 * @version 1.0
 */
public class StaticCallDemo {

    public static void main(String[] args) {
        
        // ====================================================================
        // ВАРИАНТ 1: Вызов через имя класса (Эталонный способ)
        // ====================================================================
        // Это самый правильный, читаемый и рекомендуемый подход. 
        // Сразу понятно, что метод принадлежит классу A.
        A.printVars();

        // ====================================================================
        // ВАРИАНТ 2: Вызов через экземпляр класса (Плохая практика)
        // ====================================================================
        // Java позволяет это сделать, но современные IDE подсветят это желтым цветом.
        // Это сбивает с толку, так как кажется, что метод использует состояние конкретного объекта obj.
        A obj = new A();
        obj.printVars();

        // ====================================================================
        // ВАРИАНТ 3: Вызов через null-ссылку (Вопрос с подвохом для зачета!)
        // ====================================================================
        // Если сделать так с обычным методом, программа упадет с ошибкой NullPointerException.
        // Но статический метод НЕ использует объект. Компилятор смотрит только на тип переменной (A).
        // Поэтому этот код отработает абсолютно корректно и выведет значения!
        A nullObj = null;
        nullObj.printVars();

        // ====================================================================
        // ВАРИАНТ 4: Прямой вызов (если мы находимся внутри самого класса A)
        // ====================================================================
        // Если бы метод main находился внутри самого класса A, 
        // мы могли бы вызвать метод просто по имени, без префиксов.
        // printVars(); 

        // ====================================================================
        // ВАРИАНТ 5: Вызов через статический импорт
        // ====================================================================
        // Если в начале файла прописать import static ... A.printVars;, 
        // то метод можно будет вызывать по имени откуда угодно в этом файле.
        printVars();
    }
}
