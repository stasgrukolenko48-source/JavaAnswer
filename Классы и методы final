/**
 * Демонстрация ограничений модификатора final при наследовании.
 * Практика #1 (методы) и Практика #2 (классы).
 *
 * @author Влад
 * @version 1.0
 */
public class FinalInheritanceDemo {

    // ====================================================================
    // ПРАКТИКА #1: Демонстрация final-метода
    // ====================================================================
    
    /**
     * Базовый класс секундомера.
     */
    static class Stopwatch {
        
        // Обычный метод. Наследники могут его переопределить (например, добавить звук тиканья).
        public void start() {
            System.out.println("Секундомер запущен.");
        }

        // FINAL метод. Главная логика остановки и сброса. 
        // Мы запрещаем наследникам ломать эту критически важную логику.
        public final void stopAndReset() {
            System.out.println("Секундомер остановлен, время сброшено в 00:00.");
        }
    }

    /**
     * Продвинутый секундомер. Наследуется от базового.
     */
    static class AdvancedStopwatch extends Stopwatch {
        
        //РАЗРЕШЕНО: Переопределяем обычный метод
        @Override
        public void start() {
            System.out.println("Продвинутый секундомер запущен. Запись кругов включена.");
        }

        //ОШИБКА КОМПИЛЯЦИИ: Попытка переопределить final-метод
        /*
        @Override
        public void stopAndReset() {
            System.out.println("Остановка без сброса времени."); // Ошибка: overridden method is final
        }
        */
    }

    // ====================================================================
    // ПРАКТИКА #2: Демонстрация final-класса
    // ====================================================================

    /**
     * Строго стандартизированный класс протокола соревнований.
     * Он объявлен как final, чтобы никто не смог создать наследника 
     * и изменить формат записи результатов.
     */
    final static class CompetitionProtocol {
        public void printHeader() {
            System.out.println("ОФИЦИАЛЬНЫЙ ПРОТОКОЛ СОРЕВНОВАНИЙ");
        }
    }

    // ОШИБКА КОМПИЛЯЦИИ: Попытка унаследовать final-класс
    /*
    static class FakeProtocol extends CompetitionProtocol {
        // Ошибка: cannot inherit from final 'CompetitionProtocol'
        
        @Override
        public void printHeader() {
            System.out.println("ПОДДЕЛЬНЫЙ ПРОТОКОЛ");
        }
    }
    */
}
