/**
 * Демонстрация замены конструкции if-else-if на вложенный тернарный оператор.
 * Практика #1 по условным операторам.
 *
 * @author Влад
 * @version 1.0
 */
public class TernaryPractice {

    /**
     * Точка входа в программу.
     *
     * @param args параметры командной строки
     */
    public static void main(String[] args) {
        // Задаем тестовое значение переменной a
        int a = 2; 
        
        // Решение задачи:
        // Читается так: если (a == 1), то i = 1, ИНАЧЕ (если a == 2, то i = 2, ИНАЧЕ i = 3)
        int i = (a == 1) ? 1 : ((a == 2) ? 2 : 3);
        
        System.out.println("При a = " + a + ", i = " + i);
    }
}
