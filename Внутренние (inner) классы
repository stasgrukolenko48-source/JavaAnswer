/**
 * Демонстрация работы с внутренними классами (Inner Classes) и спецификаторами доступа.
 * Охватывает Практики #1, #2 и #3.
 *
 * @author Влад
 * @version 1.0
 */
public class SwimmingPool {

    private String poolName = "Fitness House";
    public int lanesCount = 6;

    // ====================================================================
    // ПРАКТИКА #1: Спецификаторы доступа для внутренних классов
    // ====================================================================
    /*
     * Обычные (верхнеуровневые) классы могут быть только public или по умолчанию.
     * Но внутренние классы являются членами класса, поэтому к ним применимы 
     * АБСОЛЮТНО ВСЕ спецификаторы доступа, как к обычным полям или методам.
     */

    // public: доступен для создания кому угодно (при наличии объекта SwimmingPool)
    public class Receptionist {}

    // protected: доступен в пакете и классам-наследникам SwimmingPool
    protected class CleaningStaff {}

    // по умолчанию: доступен только внутри текущего пакета
    class Manager {}

    // private: доступен ТОЛЬКО внутри класса SwimmingPool.
    // Это идеальный способ скрыть вспомогательную логику от внешнего мира.
    private class WaterFilter {
        private int filterSerialNumber = 101010;

        // ====================================================================
        // ПРАКТИКА #2: Доступ внутреннего класса к внешнему
        // ====================================================================
        /**
         * Имеет ли внутренний класс доступ к полям внешнего?
         * ОТВЕТ: Да, внутренний класс имеет полный доступ ко ВСЕМ полям и методам 
         * внешнего класса, включая private. Спецификаторы этому никак не мешают.
         */
        public void cleanWater() {
            // Свободно обращаемся к private полю poolName внешнего класса
            System.out.println("Фильтр очищает воду в бассейне: " + poolName);
            
            // Свободно обращаемся к public полю
            System.out.println("Дорожек обслужено: " + lanesCount);

            // Примечание: если бы во внутреннем классе тоже была переменная poolName, 
            // мы могли бы обратиться к внешней так: SwimmingPool.this.poolName
        }
    }

    // ====================================================================
    // ПРАКТИКА #3: Доступ внешнего класса к внутреннему
    // ====================================================================
    /**
     * Имеет ли внешний класс доступ к полям внутреннего?
     * ОТВЕТ: Да, внешний класс имеет полный доступ ко ВСЕМ полям и методам 
     * внутреннего класса, включая private. 
     * НО для этого внешний класс обязан создать объект внутреннего класса.
     */
    public void runMaintenance() {
        // Создаем экземпляр нашего приватного внутреннего класса
        WaterFilter filter = new WaterFilter();

        // Свободно читаем private поле внутреннего класса! 
        // Инкапсуляция между внешним и внутренним классом не работает, они доверяют друг другу.
        System.out.println("Проверка фильтра номер: " + filter.filterSerialNumber);

        // Запускаем метод внутреннего класса
        filter.cleanWater();
    }

    /**
     * Точка входа для демонстрации работы.
     */
    public static void main(String[] args) {
        SwimmingPool myPool = new SwimmingPool();
        myPool.runMaintenance();

        // Пример создания объекта публичного внутреннего класса извне.
        // Обрати внимание на синтаксис: мы вызываем new у объекта внешнего класса.
        SwimmingPool.Receptionist rec = myPool.new Receptionist();
        
        // Попытка создать WaterFilter здесь приведет к ошибке компиляции, 
        // так как класс WaterFilter объявлен как private.
    }
}
